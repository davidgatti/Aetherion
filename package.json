{
  "name": "aetherion-cpu-monitor",
  "displayName": "Aetherion CPU Monitor",
  "description": "Real-time CPU monitoring with per-core usage visualization in VS Code status bar",
  "version": "1.0.0",
  "publisher": "gatti",
  "repository": {
    "type": "git",
    "url": "https://github.com/davidgatti/Aetherion.git"
  },
  "homepage": "https://github.com/davidgatti/Aetherion",
  "bugs": {
    "url": "https://github.com/davidgatti/Aetherion/issues"
  },
  "keywords": [
    "cpu",
    "monitor",
    "system",
    "performance",
    "status-bar",
    "real-time"
  ],
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sysmag.helloWorld",
        "title": "Hello World"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.103.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "eslint": "^9.32.0",
    "typescript": "^5.9.2",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2"
  }
}
