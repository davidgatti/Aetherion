{
  "name": "aetherion-cpu-monitor",
  "displayName": "Aetherion CPU Monitor",
  "description": "Real-time CPU, RAM, swap, disk space, disk activity, and network traffic monitoring with animated braille characters in VS Code status bar, plus per-core CPU graphs with professional visualization",
  "version": "2.0.0",
  "publisher": "gatti",
  "icon": ".assets/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/davidgatti/Aetherion.git"
  },
  "homepage": "https://github.com/davidgatti/Aetherion",
  "bugs": {
    "url": "https://github.com/davidgatti/Aetherion/issues"
  },
  "keywords": [
    "cpu",
    "monitor",
    "system",
    "performance",
    "status-bar",
    "real-time",
    "disk",
    "memory",
    "swap",
    "network",
    "traffic"
  ],
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sysmag.openSystemPanel",
        "title": "Open System Monitor Panel"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "systemMonitorPanel",
          "title": "System Monitor",
          "icon": "$(pulse)"
        }
      ]
    },
    "views": {
      "systemMonitorPanel": [
        {
          "id": "systemMonitorView",
          "name": "System Monitor",
          "type": "webview",
          "icon": "$(dashboard)"
        },
        {
          "id": "cpuGraphView",
          "name": "CPU Live Graph",
          "type": "webview",
          "icon": "$(graph)"
        },
        {
          "id": "ramGraphView",
          "name": "RAM Live Graph",
          "type": "webview",
          "icon": "$(graph)"
        },
        {
          "id": "swapGraphView",
          "name": "Swap Live Graph",
          "type": "webview",
          "icon": "$(graph)"
        },
        {
          "id": "diskGraphView",
          "name": "Disk Space Live Graph",
          "type": "webview",
          "icon": "$(graph)"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run lint:js && npm run lint:deps",
    "build": "npm run lint && npm run test",
    "lint": "npm run lint:js && npm run lint:md && npm run lint:deps",
    "lint:js": "eslint src --config .config/eslint.config.mjs",
    "lint:js:fix": "eslint src --fix --config .config/eslint.config.mjs",
    "lint:json": "eslint \"**/*.{json,jsonc}\" --config .config/eslint.config.mjs",
    "lint:json:fix": "eslint \"**/*.{json,jsonc}\" --fix --config .config/eslint.config.mjs",
    "lint:md": "markdownlint-cli2 --config .config/.markdownlint-cli2.jsonc",
    "lint:md:fix": "markdownlint-cli2 --fix --config .config/.markdownlint-cli2.jsonc",
    "lint:deps": "depcheck --config .config/.depcheckrc",
    "lint:security": "npm audit --audit-level=moderate",
    "lint:outdated": "ncu --format group",
    "lint:fix": "npm run lint:js:fix && npm run lint:json:fix && npm run lint:md:fix",
    "format": "prettier --write \"**/*.{js,json,md}\" --config .config/prettier.config.js --ignore-path .config/.prettierignore",
    "format:check": "prettier --check \"**/*.{js,json,md}\" --config .config/prettier.config.js --ignore-path .config/.prettierignore",
    "test": "vscode-test",
    "package": "vsce package --out .releases/",
    "package:patch": "npm version patch && npm run package",
    "package:minor": "npm version minor && npm run package",
    "package:major": "npm version major && npm run package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.103.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "depcheck": "^1.4.7",
    "eslint": "^9.32.0",
    "eslint-plugin-json": "^4.0.1",
    "markdownlint-cli2": "^0.18.1",
    "mocha": "^11.7.1",
    "npm-check-updates": "^18.0.3",
    "prettier": "^3.6.2"
  }
}
